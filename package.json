    "configuration": {
      "title": "DataNest",
      "properties": {
        "datanest.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "enumDescriptions": [
            "%configuration.logLevel.error%",
            "%configuration.logLevel.warn%",
            "%configuration.logLevel.info%",
            "%configuration.logLevel.debug%"
          ],
          "markdownDescription": "%configuration.logLevel.description%",
          "scope": "application"
        },
        "datanest.showSystemObjects": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.showSystemObjects.description%",
          "scope": "window"
        },
        "datanest.rowLimit": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "%configuration.rowLimit.description%",
          "scope": "window"
        },
        "datanest.pageSize": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 100000,
          "markdownDescription": "%configuration.pageSize.description%",
          "scope": "window"
        },
        "datanest.queryTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 86400,
          "markdownDescription": "%configuration.queryTimeout.description%",
          "scope": "window"
        },
        "datanest.historyLimit": {
          "type": "integer",
          "default": 500,
          "minimum": 0,
          "maximum": 10000,
          "markdownDescription": "%configuration.historyLimit.description%",
          "scope": "window"
        },
        "datanest.safeMode": {
          "type": "string",
          "enum": [
            "confirm",
            "block",
            "off"
          ],
          "default": "confirm",
          "enumDescriptions": [
            "%configuration.safeMode.confirm%",
            "%configuration.safeMode.block%",
            "%configuration.safeMode.off%"
          ],
          "markdownDescription": "%configuration.safeMode.description%",
          "scope": "window"
        },
        "datanest.transactionMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "%configuration.transactionMode.auto%",
            "%configuration.transactionMode.manual%"
          ],
          "default": "auto",
          "markdownDescription": "%configuration.transactionMode.description%"
        },
        "datanest.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "enumDescriptions": [
            "%configuration.format.case.upper%",
            "%configuration.format.case.lower%",
            "%configuration.format.case.preserve%"
          ],
          "markdownDescription": "%configuration.format.keywordCase.description%",
          "scope": "resource"
        },
        "datanest.format.dataTypeCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "preserve",
          "enumDescriptions": [
            "%configuration.format.case.upper%",
            "%configuration.format.case.lower%",
            "%configuration.format.case.preserve%"
          ],
          "markdownDescription": "%configuration.format.dataTypeCase.description%",
          "scope": "resource"
        },
        "datanest.format.functionCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "preserve",
          "enumDescriptions": [
            "%configuration.format.case.upper%",
            "%configuration.format.case.lower%",
            "%configuration.format.case.preserve%"
          ],
          "markdownDescription": "%configuration.format.functionCase.description%",
          "scope": "resource"
        },
        "datanest.format.indentStyle": {
          "type": "string",
          "enum": [
            "standard",
            "tabularLeft",
            "tabularRight"
          ],
          "default": "standard",
          "enumDescriptions": [
            "%configuration.format.indentStyle.standard%",
            "%configuration.format.indentStyle.tabularLeft%",
            "%configuration.format.indentStyle.tabularRight%"
          ],
          "markdownDescription": "%configuration.format.indentStyle.description%",
          "scope": "resource"
        },
        "datanest.format.logicalOperatorNewline": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "default": "before",
          "enumDescriptions": [
            "%configuration.format.logicalOperatorNewline.before%",
            "%configuration.format.logicalOperatorNewline.after%"
          ],
          "markdownDescription": "%configuration.format.logicalOperatorNewline.description%",
          "scope": "resource"
        },
        "datanest.format.expressionWidth": {
          "type": "integer",
          "default": 50,
          "minimum": 10,
          "maximum": 1000,
          "markdownDescription": "%configuration.format.expressionWidth.description%",
          "scope": "resource"
        },
        "datanest.format.denseOperators": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.format.denseOperators.description%",
          "scope": "resource"
        }
      }
    },
    "keybindings": [
      {
        "command": "datanest.query.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "datanest.query.runAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/datanest.json",
        "url": "./resources/schemas/connections.schema.json"
      }
    ]
