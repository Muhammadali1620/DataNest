{
  "name": "datanest",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "private": true,
  "publisher": "datanest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammadali1620/DataNest.git"
  },
  "bugs": {
    "url": "https://github.com/Muhammadali1620/DataNest/issues"
  },
  "homepage": "https://github.com/Muhammadali1620/DataNest#readme",
  "categories": [
    "Data Science",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "client"
  ],
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.12.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onView:datanest.connections"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "datanest",
          "title": "%viewsContainers.datanest.title%",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "datanest": [
        {
          "id": "datanest.connections",
          "name": "%views.connections.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "datanest.connections",
        "contents": "%viewsWelcome.connections.empty%"
      }
    ],
    "commands": [
      {
        "command": "datanest.logs.show",
        "title": "%commands.logs.show.title%",
        "category": "DataNest"
      },
      {
        "command": "datanest.connections.add",
        "title": "%commands.connections.add.title%",
        "category": "DataNest",
        "icon": "$(add)"
      },
      {
        "command": "datanest.connections.edit",
        "title": "%commands.connections.edit.title%",
        "category": "DataNest",
        "icon": "$(edit)"
      },
      {
        "command": "datanest.connections.duplicate",
        "title": "%commands.connections.duplicate.title%",
        "category": "DataNest"
      },
      {
        "command": "datanest.connections.remove",
        "title": "%commands.connections.remove.title%",
        "category": "DataNest",
        "icon": "$(trash)"
      },
      {
        "command": "datanest.connections.connect",
        "title": "%commands.connections.connect.title%",
        "category": "DataNest",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "datanest.connections.disconnect",
        "title": "%commands.connections.disconnect.title%",
        "category": "DataNest",
        "icon": "$(close)"
      },
      {
        "command": "datanest.tree.refresh",
        "title": "%commands.tree.refresh.title%",
        "category": "DataNest",
        "icon": "$(refresh)"
      },
      {
        "command": "datanest.tree.copyName",
        "title": "%commands.tree.copyName.title%",
        "category": "DataNest"
      },
      {
        "command": "datanest.query.new",
        "title": "%commands.query.new.title%",
        "category": "DataNest",
        "icon": "$(new-file)"
      },
      {
        "command": "datanest.query.selectConnection",
        "title": "%commands.query.selectConnection.title%",
        "category": "DataNest"
      },
      {
        "command": "datanest.query.run",
        "title": "%commands.query.run.title%",
        "category": "DataNest",
        "icon": "$(play)"
      },
      {
        "command": "datanest.query.runAll",
        "title": "%commands.query.runAll.title%",
        "category": "DataNest",
        "icon": "$(run-all)"
      },
      {
        "command": "datanest.query.runRange",
        "title": "%commands.query.runRange.title%",
        "category": "DataNest"
      },
      {
        "command": "datanest.query.cancel",
        "title": "%commands.query.cancel.title%",
        "category": "DataNest",
        "icon": "$(debug-stop)"
      },
      {
        "command": "datanest.results.show",
        "title": "%commands.results.show.title%",
        "category": "DataNest",
        "icon": "$(table)"
      },
      {
        "command": "datanest.dev.openPing",
        "title": "%commands.dev.openPing.title%",
        "category": "DataNest"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "datanest.dev.openPing",
          "when": "datanest.isDevelopment"
        },
        {
          "command": "datanest.query.runRange",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "datanest.connections.add",
          "when": "view == datanest.connections",
          "group": "navigation@1"
        },
        {
          "command": "datanest.tree.refresh",
          "when": "view == datanest.connections",
          "group": "navigation@2"
        },
        {
          "command": "datanest.query.new",
          "when": "view == datanest.connections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "datanest.query.new",
          "when": "view == datanest.connections && (viewItem == datanest.connection.connected || viewItem == datanest.database || viewItem == datanest.schema)",
          "group": "inline@0"
        },
        {
          "command": "datanest.connections.connect",
          "when": "view == datanest.connections && viewItem == datanest.connection",
          "group": "inline@1"
        },
        {
          "command": "datanest.connections.disconnect",
          "when": "view == datanest.connections && viewItem == datanest.connection.connected",
          "group": "inline@1"
        },
        {
          "command": "datanest.tree.refresh",
          "when": "view == datanest.connections && viewItem == datanest.connection.connected",
          "group": "inline@2"
        },
        {
          "command": "datanest.connections.edit",
          "when": "view == datanest.connections && (viewItem == datanest.connection || viewItem == datanest.connection.connected)",
          "group": "inline@3"
        },
        {
          "command": "datanest.connections.connect",
          "when": "view == datanest.connections && viewItem == datanest.connection",
          "group": "1_state@1"
        },
        {
          "command": "datanest.connections.disconnect",
          "when": "view == datanest.connections && viewItem == datanest.connection.connected",
          "group": "1_state@1"
        },
        {
          "command": "datanest.tree.refresh",
          "when": "view == datanest.connections && (viewItem == datanest.connection || viewItem == datanest.connection.connected)",
          "group": "1_state@2"
        },
        {
          "command": "datanest.connections.edit",
          "when": "view == datanest.connections && (viewItem == datanest.connection || viewItem == datanest.connection.connected)",
          "group": "2_edit@1"
        },
        {
          "command": "datanest.connections.duplicate",
          "when": "view == datanest.connections && (viewItem == datanest.connection || viewItem == datanest.connection.connected)",
          "group": "2_edit@2"
        },
        {
          "command": "datanest.connections.remove",
          "when": "view == datanest.connections && (viewItem == datanest.connection || viewItem == datanest.connection.connected)",
          "group": "3_remove@1"
        },
        {
          "command": "datanest.tree.copyName",
          "when": "view == datanest.connections && (viewItem == datanest.database || viewItem == datanest.schema || viewItem == datanest.table || viewItem == datanest.view || viewItem == datanest.column)",
          "group": "5_copy@1"
        },
        {
          "command": "datanest.tree.refresh",
          "when": "view == datanest.connections && (viewItem == datanest.database || viewItem == datanest.schema || viewItem == datanest.table || viewItem == datanest.view || viewItem == datanest.column)",
          "group": "1_state@1"
        },
        {
          "command": "datanest.query.new",
          "when": "view == datanest.connections && (viewItem == datanest.connection.connected || viewItem == datanest.database || viewItem == datanest.schema)",
          "group": "0_query@1"
        }
      ],
      "editor/title": [
        {
          "command": "datanest.query.cancel",
          "when": "editorLangId == sql && datanest.queryRunning",
          "group": "navigation@0"
        },
        {
          "command": "datanest.query.run",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "datanest.query.runAll",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "datanest.results.show",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "datanest.query.run",
          "when": "editorLangId == sql",
          "group": "0_datanest@1"
        },
        {
          "command": "datanest.query.runAll",
          "when": "editorLangId == sql",
          "group": "0_datanest@2"
        },
        {
          "command": "datanest.query.cancel",
          "when": "editorLangId == sql && datanest.queryRunning",
          "group": "0_datanest@3"
        }
      ]
    },
    "configuration": {
      "title": "DataNest",
      "properties": {
        "datanest.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "enumDescriptions": [
            "%configuration.logLevel.error%",
            "%configuration.logLevel.warn%",
            "%configuration.logLevel.info%",
            "%configuration.logLevel.debug%"
          ],
          "markdownDescription": "%configuration.logLevel.description%",
          "scope": "application"
        },
        "datanest.showSystemObjects": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.showSystemObjects.description%",
          "scope": "window"
        },
        "datanest.rowLimit": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "%configuration.rowLimit.description%",
          "scope": "window"
        }
      }
    },
    "keybindings": [
      {
        "command": "datanest.query.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "datanest.query.runAll",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . && tsc -p test/e2e && svelte-check --tsconfig ./webview/tsconfig.json --fail-on-warnings --threshold warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test:e2e": "npm run build && node scripts/build-e2e.mjs && vscode-test",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies",
    "db:up": "docker compose -f docker/compose.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.yml down --volumes",
    "db:reset": "npm run db:down && npm run db:up",
    "db:logs": "docker compose -f docker/compose.yml logs -f",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "mysql2": "3.24.6",
    "ovsx": "1.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "serialize-javascript": "^7.1.3",
    "diff": "^8.0.3",
    "@azure/msal-node": "^7.1.1"
  }
}
