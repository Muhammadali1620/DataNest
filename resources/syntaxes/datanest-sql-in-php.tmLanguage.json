{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SQL in marked strings (PHP)",
  "scopeName": "datanest.sql-injection.php",
  "injectionSelector": "L:source.php -comment -string",
  "patterns": [
    {
      "begin": "(?i)(/\\*\\s*(?:language\\s*=\\s*)?sql\\s*\\*/)\\s*()([\"'])",
      "end": "(\\3)|$",
      "name": "string.quoted.embedded-sql",
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape"
        },
        {
          "include": "source.sql"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "comment.block.embedded-sql-marker"
        }
      }
    },
    {
      "begin": "(?i)((?:\\/\\/|#)\\s*(?:language\\s*=\\s*)?sql)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "comment.line.embedded-sql-marker"
        }
      },
      "end": "^(?![^\\n]*[\\x60\"'])|(?<=[\\x60\"'])",
      "patterns": [
        {
          "begin": "()([\"'])",
          "end": "(\\2)|$",
          "name": "string.quoted.embedded-sql",
          "contentName": "meta.embedded.block.sql",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape"
            },
            {
              "include": "source.sql"
            }
          ]
        }
      ]
    },
    {
      "begin": "(<<<)\\s*([\"']?)(SQL|sql)\\2\\s*$",
      "beginCaptures": {
        "3": {
          "name": "keyword.operator.heredoc"
        }
      },
      "end": "^\\s*(\\3)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.heredoc"
        }
      },
      "name": "string.unquoted.heredoc.embedded-sql",
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    }
  ]
}
